import tkinter as tk
from tkinter import messagebox

def obtener_tramos(arr):
    tramos = []
    if not arr:
        return tramos
    actual = [arr[0]]
    for i in range(1, len(arr)):
        if arr[i] >= arr[i - 1]:
            actual.append(arr[i])
        else:
            tramos.append(actual)
            actual = [arr[i]]
    tramos.append(actual)
    return tramos

def mezclar(t1, t2):
    res = []
    i = j = 0
    while i < len(t1) and j < len(t2):
        if t1[i] <= t2[j]:
            res.append(t1[i])
            i += 1
        else:
            res.append(t2[j])
            j += 1
    res.extend(t1[i:])
    res.extend(t2[j:])
    return res

def mezcla_equilibrada(arr):
    tramos = obtener_tramos(arr)
    while len(tramos) > 1:
        nuevos = []
        for i in range(0, len(tramos), 2):
            if i + 1 < len(tramos):
                nuevos.append(mezclar(tramos[i], tramos[i+1]))
            else:
                nuevos.append(tramos[i])
        tramos = nuevos
    return tramos[0] if tramos else []

def ejecutar():
    try:
        arr = list(map(int, entry.get().split(',')))
        resultado = mezcla_equilibrada(arr)
        lbl_res.config(text=f"Resultado: {resultado}")
    except ValueError:
        messagebox.showerror("Error", "Ingrese números válidos separados por coma")

root = tk.Tk()
root.title("Mezcla Equilibrada")
root.geometry("400x200")
tk.Label(root, text="Lista a ordenar (separadas por coma):").pack(pady=5)
entry = tk.Entry(root, width=40)
entry.pack()
tk.Button(root, text="Ordenar", command=ejecutar).pack(pady=10)
lbl_res = tk.Label(root, text="Resultado: ")
lbl_res.pack(pady=10)
root.mainloop()
  
