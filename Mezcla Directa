import tkinter as tk
from tkinter import messagebox

def mezcla_directa(arr):
    if len(arr) <= 1:
        return arr
    n = len(arr)
    tam = 1
    while tam < n:
        l = 0
        while l < n:
            m = l + tam
            r = min(l + 2 * tam, n)
            if m < r:
                izq = arr[l:m]
                der = arr[m:r]
                i = j = 0
                k = l
                while i < len(izq) and j < len(der):
                    if izq[i] <= der[j]:
                        arr[k] = izq[i]
                        i += 1
                    else:
                        arr[k] = der[j]
                        j += 1
                    k += 1
                while i < len(izq):
                    arr[k] = izq[i]
                    i += 1
                    k += 1
                while j < len(der):
                    arr[k] = der[j]
                    j += 1
                    k += 1
            l += 2 * tam
        tam *= 2
    return arr

def ejecutar():
    try:
        arr = list(map(int, entry.get().split(',')))
        resultado = mezcla_directa(arr)
        lbl_res.config(text=f"Resultado: {resultado}")
    except ValueError:
        messagebox.showerror("Error", "Ingrese números válidos separados por coma")

root = tk.Tk()
root.title("Mezcla Directa")
root.geometry("400x200")
tk.Label(root, text="Lista a ordenar (separadas por coma):").pack(pady=5)
entry = tk.Entry(root, width=40)
entry.pack()
tk.Button(root, text="Ordenar", command=ejecutar).pack(pady=10)
lbl_res = tk.Label(root, text="Resultado: ")
lbl_res.pack(pady=10)
root.mainloop()
